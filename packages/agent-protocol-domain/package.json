{
  "name": "@ocentra-parent/agent-protocol-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Generated/thin protocol adapters and parsers for Rust-owned agent protocol contracts.",
  "exports": {
    "./activity-surface-adapter": {
      "import": "./dist/activity-surface-adapter.js",
      "types": "./dist/activity-surface-adapter.d.ts"
    },
    "./network-runtime-events": {
      "import": "./dist/network-runtime-events.js",
      "types": "./dist/network-runtime-events.d.ts"
    },
    "./network-remote-delivery-status": {
      "import": "./dist/network-remote-delivery-status.js",
      "types": "./dist/network-remote-delivery-status.d.ts"
    },
    "./network-live-capture-status": {
      "import": "./dist/network-live-capture-status.js",
      "types": "./dist/network-live-capture-status.d.ts"
    },
    "./network-linux-nftables-lab-status": {
      "import": "./dist/network-linux-nftables-lab-status.js",
      "types": "./dist/network-linux-nftables-lab-status.d.ts"
    },
    "./network-windows-firewall-lab-status": {
      "import": "./dist/network-windows-firewall-lab-status.js",
      "types": "./dist/network-windows-firewall-lab-status.d.ts"
    },
    "./network-windows-wfp-gate-status": {
      "import": "./dist/network-windows-wfp-gate-status.js",
      "types": "./dist/network-windows-wfp-gate-status.d.ts"
    },
    "./network-android-vpnservice-gate-status": {
      "import": "./dist/network-android-vpnservice-gate-status.js",
      "types": "./dist/network-android-vpnservice-gate-status.d.ts"
    },
    "./network-apple-network-extension-gate-status": {
      "import": "./dist/network-apple-network-extension-gate-status.js",
      "types": "./dist/network-apple-network-extension-gate-status.d.ts"
    },
    "./tracking-retention-settings-write-command": {
      "import": "./dist/tracking-retention-settings-write-command.js",
      "types": "./dist/tracking-retention-settings-write-command.d.ts"
    },
    "./agent-message-codec": {
      "import": "./dist/agent-message-codec.js",
      "types": "./dist/agent-message-codec.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/agent-protocol-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
