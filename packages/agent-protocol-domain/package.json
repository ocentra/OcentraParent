{
  "name": "@ocentra-parent/agent-protocol-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Shared agent command and event contracts for localhost and future relay transports.",
  "exports": {
    "./activity-surface-adapter": {
      "import": "./dist/activity-surface-adapter.js",
      "types": "./dist/activity-surface-adapter.d.ts"
    },
    "./browser-policy-adapter": {
      "import": "./dist/browser-policy-adapter.js",
      "types": "./dist/browser-policy-adapter.d.ts"
    },
    "./screen-settings-adapter": {
      "import": "./dist/screen-settings-adapter.js",
      "types": "./dist/screen-settings-adapter.d.ts"
    },
    "./enforcement-product-control-adapter": {
      "import": "./dist/enforcement-product-control-adapter.js",
      "types": "./dist/enforcement-product-control-adapter.d.ts"
    },
    "./enforcement-policy-dispatch-adapter": {
      "import": "./dist/enforcement-policy-dispatch-adapter.js",
      "types": "./dist/enforcement-policy-dispatch-adapter.d.ts"
    },
    "./enforcement-broad-adapter-proof-adapter": {
      "import": "./dist/enforcement-broad-adapter-proof-adapter.js",
      "types": "./dist/enforcement-broad-adapter-proof-adapter.d.ts"
    },
    "./enforcement-supported-adapter-runtime-proof-adapter": {
      "import": "./dist/enforcement-supported-adapter-runtime-proof-adapter.js",
      "types": "./dist/enforcement-supported-adapter-runtime-proof-adapter.d.ts"
    },
    "./parent-assistant-adapter": {
      "import": "./dist/parent-assistant-adapter.js",
      "types": "./dist/parent-assistant-adapter.d.ts"
    },
    "./tracking-read-model": {
      "import": "./dist/tracking-read-model.js",
      "types": "./dist/tracking-read-model.d.ts"
    },
    "./network-runtime-events": {
      "import": "./dist/network-runtime-events.js",
      "types": "./dist/network-runtime-events.d.ts"
    },
    "./network-remote-delivery-status": {
      "import": "./dist/network-remote-delivery-status.js",
      "types": "./dist/network-remote-delivery-status.d.ts"
    },
    "./app-game-boundary-read-model": {
      "import": "./dist/app-game-boundary-read-model.js",
      "types": "./dist/app-game-boundary-read-model.d.ts"
    },
    "./app-game-policy-readiness": {
      "import": "./dist/app-game-policy-readiness.js",
      "types": "./dist/app-game-policy-readiness.d.ts"
    },
    "./app-game-notification-readiness": {
      "import": "./dist/app-game-notification-readiness.js",
      "types": "./dist/app-game-notification-readiness.d.ts"
    },
    "./contracts": {
      "import": "./dist/contracts.js",
      "types": "./dist/contracts.d.ts"
    },
    "./security": {
      "import": "./dist/security.js",
      "types": "./dist/security.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/agent-protocol-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/activity-domain": "file:../activity-domain",
    "@ocentra-parent/logging-domain": "file:../logging-domain",
    "@ocentra-parent/parent-domain": "file:../parent-domain",
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
