{
  "name": "@ocentra-parent/logging-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Parent-local logging helpers and focused proof coverage over Rust-owned contracts.",
  "exports": {
    "./core/logConfig": {
      "import": "./dist/core/logConfig.js",
      "types": "./dist/core/logConfig.d.ts"
    },
    "./core/logDecisionProvider": {
      "import": "./dist/core/logDecisionProvider.js",
      "types": "./dist/core/logDecisionProvider.d.ts"
    },
    "./core/logger": {
      "import": "./dist/core/logger.js",
      "types": "./dist/core/logger.d.ts"
    },
    "./core/stackTrace": {
      "import": "./dist/core/stackTrace.js",
      "types": "./dist/core/stackTrace.d.ts"
    },
    "./test-log/bridgeConvert": {
      "import": "./dist/test-log/bridgeConvert.js",
      "types": "./dist/test-log/bridgeConvert.d.ts"
    },
    "./test-log/ndjsonPaths": {
      "import": "./dist/test-log/ndjsonPaths.js",
      "types": "./dist/test-log/ndjsonPaths.d.ts"
    },
    "./test-log/ndjsonLogFileWriter": {
      "import": "./dist/test-log/ndjsonLogFileWriter.js",
      "types": "./dist/test-log/ndjsonLogFileWriter.d.ts"
    },
    "./test-log/ndjsonWriter": {
      "import": "./dist/test-log/ndjsonWriter.js",
      "types": "./dist/test-log/ndjsonWriter.d.ts"
    },
    "./test-log/logsTree": {
      "import": "./dist/test-log/logsTree.js",
      "types": "./dist/test-log/logsTree.d.ts"
    },
    "./test-log/wipeNdjsonScope": {
      "import": "./dist/test-log/wipeNdjsonScope.js",
      "types": "./dist/test-log/wipeNdjsonScope.d.ts"
    },
    "./test-log/testLogRetention": {
      "import": "./dist/test-log/testLogRetention.js",
      "types": "./dist/test-log/testLogRetention.d.ts"
    },
    "./test-log/ingestManifest": {
      "import": "./dist/test-log/ingestManifest.js",
      "types": "./dist/test-log/ingestManifest.d.ts"
    },
    "./test-log/testLogDuckDb": {
      "import": "./dist/test-log/testLogDuckDb.js",
      "types": "./dist/test-log/testLogDuckDb.d.ts"
    },
    "./transport/bridgeTransport": {
      "import": "./dist/transport/bridgeTransport.js",
      "types": "./dist/transport/bridgeTransport.d.ts"
    },
    "./transport/bridgeServer": {
      "import": "./dist/transport/bridgeServer.js",
      "types": "./dist/transport/bridgeServer.d.ts"
    },
    "./app-log/appNdjsonWriter": {
      "import": "./dist/app-log/appNdjsonWriter.js",
      "types": "./dist/app-log/appNdjsonWriter.d.ts"
    },
    "./app-log/createAppLogStorage": {
      "import": "./dist/app-log/createAppLogStorage.js",
      "types": "./dist/app-log/createAppLogStorage.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "bridge": "tsx scripts/log-bridge.ts",
    "db:ensure": "tsx scripts/ensure-db.ts",
    "db:rebuild": "tsx scripts/rebuild-db-from-ndjson.ts",
    "db:ingest": "tsx scripts/rebuild-db-from-ndjson.ts --no-delete",
    "logs:wipe": "tsx scripts/wipe-logs.ts",
    "logs:retention": "tsx scripts/retention-logs.ts",
    "logs:prepare": "tsx scripts/prepare-ndjson-logs.ts",
    "test:query": "tsx scripts/query-test-logs.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "view:ndjson": "tsx scripts/view-ndjson.ts",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/logging-domain",
    "lint:exec": "eslint --cache src scripts tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "duckdb": "^1.4.4",
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
