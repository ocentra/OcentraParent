{
  "name": "@ocentra-parent/capability-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Shared capability names, statuses, and capability catalog contracts.",
  "exports": {
    "./capabilities": {
      "import": "./dist/src/capabilities.js",
      "types": "./dist/src/capabilities.d.ts"
    },
    "./capability-data": {
      "import": "./dist/src/capability-data.js",
      "types": "./dist/src/capability-data.d.ts"
    },
    "./package-info": {
      "import": "./dist/src/package-info.js",
      "types": "./dist/src/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/capability-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
