{
  "name": "@ocentra-parent/endpoint-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Endpoint, path, header, and route boundary contracts.",
  "exports": {
    "./types/brands": {
      "import": "./dist/types/brands.js",
      "types": "./dist/types/brands.d.ts"
    },
    "./constants/http": {
      "import": "./dist/constants/http.js",
      "types": "./dist/constants/http.d.ts"
    },
    "./constants/versions": {
      "import": "./dist/constants/versions.js",
      "types": "./dist/constants/versions.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/endpoint-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
