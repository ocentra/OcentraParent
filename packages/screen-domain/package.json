{
  "name": "@ocentra-parent/screen-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Screen capture, screen evidence, OCR, VLM, disclosure, and settings contracts.",
  "exports": {
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    },
    "./screen-ai-enforcement-handoff-guard-proof": {
      "import": "./dist/screen-ai-enforcement-handoff-guard-proof.js",
      "types": "./dist/screen-ai-enforcement-handoff-guard-proof.d.ts"
    },
    "./screen-child-disclosure-page": {
      "import": "./dist/screen-child-disclosure-page.js",
      "types": "./dist/screen-child-disclosure-page.d.ts"
    },
    "./screen-evidence-family-hub-routing": {
      "import": "./dist/screen-evidence-family-hub-routing.js",
      "types": "./dist/screen-evidence-family-hub-routing.d.ts"
    },
    "./screen-intelligence-router": {
      "import": "./dist/screen-intelligence-router.js",
      "types": "./dist/screen-intelligence-router.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/screen-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/ai-domain": "file:../ai-domain",
    "@ocentra-parent/browser-domain": "file:../browser-domain",
    "@ocentra-parent/enforcement-domain": "file:../enforcement-domain",
    "@ocentra-parent/event-domain": "file:../event-domain",
    "@ocentra-parent/family-domain": "file:../family-domain",
    "@ocentra-parent/lan-domain": "file:../lan-domain",
    "@ocentra-parent/policy-domain": "file:../policy-domain",
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
