{
  "name": "@ocentra-parent/text-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Shared text value contracts and display text tokens.",
  "exports": {
    "./contracts": {
      "import": "./dist/contracts.js",
      "types": "./dist/contracts.d.ts"
    },
    "./browser-child-ux": {
      "import": "./dist/browser-child-ux.js",
      "types": "./dist/browser-child-ux.d.ts"
    },
    "./browser-parent-explanation": {
      "import": "./dist/browser-parent-explanation.js",
      "types": "./dist/browser-parent-explanation.d.ts"
    },
    "./screen-child-disclosure-ux-text": {
      "import": "./dist/screen-child-disclosure-ux-text.js",
      "types": "./dist/screen-child-disclosure-ux-text.d.ts"
    },
    "./social-dashboard-ux-text": {
      "import": "./dist/social-dashboard-ux-text.js",
      "types": "./dist/social-dashboard-ux-text.d.ts"
    },
    "./social-child-approval-block-ux-text": {
      "import": "./dist/social-child-approval-block-ux-text.js",
      "types": "./dist/social-child-approval-block-ux-text.d.ts"
    },
    "./portal-dev": {
      "import": "./dist/portal-dev.js",
      "types": "./dist/portal-dev.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/text-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
