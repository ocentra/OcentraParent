{
  "name": "@ocentra-parent/tracking-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Tracking runtime helpers, policy proofs, and projections built from centralized schemas.",
  "exports": {
    "./tracking-local-place-store": {
      "import": "./dist/tracking-local-place-store.js",
      "types": "./dist/tracking-local-place-store.d.ts"
    },
    "./tracking-policy-compiler-runtime-proof": {
      "import": "./dist/tracking-policy-compiler-runtime-proof.js",
      "types": "./dist/tracking-policy-compiler-runtime-proof.d.ts"
    },
    "./tracking-retention-runtime": {
      "import": "./dist/tracking-retention-runtime.js",
      "types": "./dist/tracking-retention-runtime.d.ts"
    },
    "./tracking-runtime": {
      "import": "./dist/tracking-runtime.js",
      "types": "./dist/tracking-runtime.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/tracking-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
