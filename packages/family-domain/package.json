{
  "name": "@ocentra-parent/family-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Family-domain helpers that consume canonical schema-domain family contracts.",
  "exports": {
    "./session-lifecycle": {
      "import": "./dist/session-lifecycle.js",
      "types": "./dist/session-lifecycle.d.ts"
    },
    "./child-profile": {
      "import": "./dist/child-profile.js",
      "types": "./dist/child-profile.d.ts"
    },
    "./household-authority": {
      "import": "./dist/household-authority.js",
      "types": "./dist/household-authority.d.ts"
    },
    "./setup-lifecycle": {
      "import": "./dist/setup-lifecycle.js",
      "types": "./dist/setup-lifecycle.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/family-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
