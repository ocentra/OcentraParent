{
  "name": "@ocentra-parent/family-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Shared family, profile, device, actor, and evidence reference contracts.",
  "exports": {
    "./reference-primitives": {
      "import": "./dist/reference-primitives.js",
      "types": "./dist/reference-primitives.d.ts"
    },
    "./references": {
      "import": "./dist/references.js",
      "types": "./dist/references.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/family-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
