{
  "name": "@ocentra-parent/enforcement-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Enforcement read-model values and package identity surfaces.",
  "exports": {
    "./tamper-uninstall-artifact-status-read-model": {
      "import": "./dist/src/tamper-uninstall-artifact-status-read-model.js",
      "types": "./dist/src/tamper-uninstall-artifact-status-read-model.d.ts"
    },
    "./v0-8-browser-enforcement-timer-recovery-proof-values": {
      "import": "./dist/src/v0-8-browser-enforcement-timer-recovery-proof-values.js",
      "types": "./dist/src/v0-8-browser-enforcement-timer-recovery-proof-values.d.ts"
    },
    "./package-info": {
      "import": "./dist/src/package-info.js",
      "types": "./dist/src/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/enforcement-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
