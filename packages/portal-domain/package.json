{
  "name": "@ocentra-parent/portal-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Portal route, DOM, and development UI contracts.",
  "exports": {
    "./app-game-adapter-execution-readiness-panel": {
      "import": "./dist/app-game-adapter-execution-readiness-panel.js",
      "types": "./dist/app-game-adapter-execution-readiness-panel.d.ts"
    },
    "./app-game-adapter-dispatch-preflight-panel": {
      "import": "./dist/app-game-adapter-dispatch-preflight-panel.js",
      "types": "./dist/app-game-adapter-dispatch-preflight-panel.d.ts"
    },
    "./app-game-adapter-dispatch-result-panel": {
      "import": "./dist/app-game-adapter-dispatch-result-panel.js",
      "types": "./dist/app-game-adapter-dispatch-result-panel.d.ts"
    },
    "./app-game-child-runtime-transport-receipt-panel": {
      "import": "./dist/app-game-child-runtime-transport-receipt-panel.js",
      "types": "./dist/app-game-child-runtime-transport-receipt-panel.d.ts"
    },
    "./app-game-platform-proof-status-panel": {
      "import": "./dist/app-game-platform-proof-status-panel.js",
      "types": "./dist/app-game-platform-proof-status-panel.d.ts"
    },
    "./contracts": {
      "import": "./dist/contracts.js",
      "types": "./dist/contracts.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    },
    "./live-activity-state": {
      "import": "./dist/live-activity-state.js",
      "types": "./dist/live-activity-state.d.ts"
    },
    "./browser-action-intent-stream-status": {
      "import": "./dist/browser-action-intent-stream-status.js",
      "types": "./dist/browser-action-intent-stream-status.d.ts"
    },
    "./screen-summary-panel": {
      "import": "./dist/screen-summary-panel.js",
      "types": "./dist/screen-summary-panel.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/portal-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/activity-domain": "file:../activity-domain",
    "@ocentra-parent/agent-protocol-domain": "file:../agent-protocol-domain",
    "@ocentra-parent/app-game-domain": "file:../app-game-domain",
    "@ocentra-parent/browser-domain": "file:../browser-domain",
    "@ocentra-parent/evidence-domain": "file:../evidence-domain",
    "@ocentra-parent/family-domain": "file:../family-domain",
    "@ocentra-parent/logging-domain": "file:../logging-domain",
    "@ocentra-parent/network-domain": "file:../network-domain",
    "@ocentra-parent/parent-domain": "file:../parent-domain",
    "@ocentra-parent/schema-domain": "file:../schema-domain",
    "@ocentra-parent/screen-domain": "file:../screen-domain",
    "@ocentra-parent/social-domain": "file:../social-domain",
    "@ocentra-parent/text-domain": "file:../text-domain"
  }
}
