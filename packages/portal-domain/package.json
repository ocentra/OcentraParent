{
  "name": "@ocentra-parent/portal-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Portal route, DOM, and development UI contracts.",
  "exports": {
    "./app-game-adapter-execution-readiness-panel": {
      "import": "./dist/app-game-adapter-execution-readiness-panel.js",
      "types": "./dist/app-game-adapter-execution-readiness-panel.d.ts"
    },
    "./app-game-adapter-dispatch-preflight-panel": {
      "import": "./dist/app-game-adapter-dispatch-preflight-panel.js",
      "types": "./dist/app-game-adapter-dispatch-preflight-panel.d.ts"
    },
    "./app-game-adapter-dispatch-result-panel": {
      "import": "./dist/app-game-adapter-dispatch-result-panel.js",
      "types": "./dist/app-game-adapter-dispatch-result-panel.d.ts"
    },
    "./contracts": {
      "import": "./dist/contracts.js",
      "types": "./dist/contracts.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/portal-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/activity-domain": "file:../activity-domain",
    "@ocentra-parent/agent-protocol-domain": "file:../agent-protocol-domain",
    "@ocentra-parent/parent-domain": "file:../parent-domain",
    "@ocentra-parent/schema-domain": "file:../schema-domain",
    "@ocentra-parent/text-domain": "file:../text-domain"
  }
}
