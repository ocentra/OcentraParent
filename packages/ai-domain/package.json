{
  "name": "@ocentra-parent/ai-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "AI-domain package identity and focused tests; canonical shared AI contracts live in @ocentra-parent/schema-domain.",
  "exports": {
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/ai-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/family-domain": "file:../family-domain",
    "@ocentra-parent/lan-domain": "file:../lan-domain",
    "@ocentra-parent/policy-domain": "file:../policy-domain",
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
