{
  "name": "@ocentra-parent/ai-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Shared AI boundary contracts for UI-facing schemas and runtime protocol handoff.",
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./local-ai-context": {
      "import": "./dist/local-ai-context.js",
      "types": "./dist/local-ai-context.d.ts"
    },
    "./local-ai-context-builder": {
      "import": "./dist/local-ai-context-builder.js",
      "types": "./dist/local-ai-context-builder.d.ts"
    },
    "./local-ai-model-artifacts": {
      "import": "./dist/local-ai-model-artifacts.js",
      "types": "./dist/local-ai-model-artifacts.d.ts"
    },
    "./local-ai-primitives": {
      "import": "./dist/local-ai-primitives.js",
      "types": "./dist/local-ai-primitives.d.ts"
    },
    "./local-ai-runtime": {
      "import": "./dist/local-ai-runtime.js",
      "types": "./dist/local-ai-runtime.d.ts"
    },
    "./local-ai-provider-scheduler": {
      "import": "./dist/local-ai-provider-scheduler.js",
      "types": "./dist/local-ai-provider-scheduler.d.ts"
    },
    "./context-primitives": {
      "import": "./dist/context-primitives.js",
      "types": "./dist/context-primitives.d.ts"
    },
    "./primitives": {
      "import": "./dist/primitives.js",
      "types": "./dist/primitives.d.ts"
    },
    "./references": {
      "import": "./dist/references.js",
      "types": "./dist/references.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/ai-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/evidence-domain": "file:../evidence-domain",
    "@ocentra-parent/family-domain": "file:../family-domain",
    "@ocentra-parent/lan-domain": "file:../lan-domain",
    "@ocentra-parent/policy-domain": "file:../policy-domain",
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
