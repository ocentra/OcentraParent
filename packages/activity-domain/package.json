{
  "name": "@ocentra-parent/activity-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Device activity capture, journal, read-model, and family aggregation contracts.",
  "exports": {
    "./browser-ai-parent-explanation-schemas": {
      "import": "./dist/browser-ai-parent-explanation-schemas.js",
      "types": "./dist/browser-ai-parent-explanation-schemas.d.ts"
    },
    "./browser-ai-parent-explanation-values": {
      "import": "./dist/browser-ai-parent-explanation-values.js",
      "types": "./dist/browser-ai-parent-explanation-values.d.ts"
    },
    "./activity-family-aggregation": {
      "import": "./dist/activity-family-aggregation.js",
      "types": "./dist/activity-family-aggregation.d.ts"
    },
    "./activity-surface": {
      "import": "./dist/activity-surface.js",
      "types": "./dist/activity-surface.d.ts"
    },
    "./capture": {
      "import": "./dist/capture.js",
      "types": "./dist/capture.d.ts"
    },
    "./journal": {
      "import": "./dist/journal.js",
      "types": "./dist/journal.d.ts"
    },
    "./journal-primitives": {
      "import": "./dist/journal-primitives.js",
      "types": "./dist/journal-primitives.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    },
    "./query": {
      "import": "./dist/query.js",
      "types": "./dist/query.d.ts"
    },
    "./screen-vlm-journal-read-model": {
      "import": "./dist/screen-vlm-journal-read-model.js",
      "types": "./dist/screen-vlm-journal-read-model.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/activity-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/app-game-domain": "file:../app-game-domain",
    "@ocentra-parent/evidence-domain": "file:../evidence-domain",
    "@ocentra-parent/schema-domain": "file:../schema-domain",
    "@ocentra-parent/screen-domain": "file:../screen-domain"
  }
}
