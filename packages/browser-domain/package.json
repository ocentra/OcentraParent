{
  "name": "@ocentra-parent/browser-domain",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Managed browser, browser game, URL intelligence, and browser intervention contracts.",
  "exports": {
    "./browser-game-hidden-analysis-profile-safety": {
      "import": "./dist/browser-game-hidden-analysis-profile-safety.js",
      "types": "./dist/browser-game-hidden-analysis-profile-safety.d.ts"
    },
    "./browser-game-policy-compiler": {
      "import": "./dist/browser-game-policy-compiler.js",
      "types": "./dist/browser-game-policy-compiler.d.ts"
    },
    "./browser-game-url-shape-parser": {
      "import": "./dist/browser-game-url-shape-parser.js",
      "types": "./dist/browser-game-url-shape-parser.d.ts"
    },
    "./browser-policy-questionnaire-forest": {
      "import": "./dist/browser-policy-questionnaire-forest.js",
      "types": "./dist/browser-policy-questionnaire-forest.d.ts"
    },
    "./browser-url-intelligence": {
      "import": "./dist/browser-url-intelligence.js",
      "types": "./dist/browser-url-intelligence.d.ts"
    },
    "./social-policy-compiler": {
      "import": "./dist/social-policy-compiler.js",
      "types": "./dist/social-policy-compiler.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/browser-domain",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/family-domain": "file:../family-domain",
    "@ocentra-parent/notification-domain": "file:../notification-domain",
    "@ocentra-parent/policy-domain": "file:../policy-domain",
    "@ocentra-parent/schema-domain": "file:../schema-domain"
  }
}
