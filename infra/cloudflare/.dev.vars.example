ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_MAX_BYTES=1048576
BILLING_ROUTE_KILL_SWITCH=false
AUTH_ADAPTER_MODE=account-auth-adapter-manual-required
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CLOCK_SKEW_SECONDS=60
FIREBASE_JWKS_CACHE_SECONDS=300
INTERNAL_QUEUE_SHARED_SECRET=REPLACE_WITH_LOCAL_ONLY_SECRET
STRIPE_SECRET_KEY=REPLACE_WITH_LOCAL_ONLY_SECRET
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_LOCAL_ONLY_SECRET
RAZORPAY_KEY_ID=REPLACE_WITH_LOCAL_ONLY_SECRET
RAZORPAY_KEY_SECRET=REPLACE_WITH_LOCAL_ONLY_SECRET
PAYPAL_CLIENT_ID=REPLACE_WITH_LOCAL_ONLY_SECRET
PAYPAL_CLIENT_SECRET=REPLACE_WITH_LOCAL_ONLY_SECRET
APPLE_STORE_KEY_REF=REPLACE_WITH_LOCAL_ONLY_SECRET_REF
GOOGLE_PLAY_SERVICE_ACCOUNT_REF=REPLACE_WITH_LOCAL_ONLY_SECRET_REF
ENTITLEMENT_SIGNING_KEY_REF=REPLACE_WITH_LOCAL_ONLY_SECRET_REF
