<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/OcentraParentTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AndroidMediaProjectionCaptureActivity"
            android:exported="false" />

        <receiver
            android:name=".AppGameAndroidChildRuntimeReceiptReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ca.ocentra.parent.agent.APP_GAME_CHILD_RUNTIME_RECEIPT_CHANNEL_PROOF" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".AppGameAndroidChildRuntimeDeliveryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ca.ocentra.parent.agent.APP_GAME_CHILD_RUNTIME_DELIVERY_INTAKE_PROOF" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".AppGameAndroidChildRuntimeNotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ca.ocentra.parent.agent.APP_GAME_CHILD_RUNTIME_NOTIFICATION_REQUEST_ACTION_PROOF" />
            </intent-filter>
        </receiver>

        <service
            android:name=".OcentraParentAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".AndroidMediaProjectionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".AppGameAndroidAccessibilityRuntimeService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_game_accessibility_service" />
        </service>
    </application>
</manifest>
