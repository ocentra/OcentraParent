<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/OcentraChildTheme">
        <activity
            android:name="ca.ocentra.child.agent.ChildAgentActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Legacy Android capability adapters remain declared behind the child shell. -->
        <activity
            android:name="ca.ocentra.parent.agent.AndroidMediaProjectionCaptureActivity"
            android:exported="false" />

        <receiver
            android:name="ca.ocentra.parent.agent.AppGameAndroidChildRuntimeReceiptReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ca.ocentra.parent.agent.APP_GAME_CHILD_RUNTIME_RECEIPT_CHANNEL_PROOF" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="ca.ocentra.parent.agent.AppGameAndroidChildRuntimeDeliveryReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ca.ocentra.parent.agent.APP_GAME_CHILD_RUNTIME_DELIVERY_INTAKE_PROOF" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="ca.ocentra.parent.agent.AppGameAndroidChildRuntimeNotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ca.ocentra.parent.agent.APP_GAME_CHILD_RUNTIME_NOTIFICATION_REQUEST_ACTION_PROOF" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="ca.ocentra.parent.agent.TrackingAndroidGeofenceTransitionReceiver"
            android:exported="false" />
        <service
            android:name="ca.ocentra.child.agent.ChildAgentCompositionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="ca.ocentra.parent.agent.OcentraParentAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="ca.ocentra.parent.agent.AndroidMediaProjectionCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name="ca.ocentra.parent.agent.AppGameAndroidAccessibilityRuntimeService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/app_game_accessibility_service" />
        </service>
    </application>
</manifest>
