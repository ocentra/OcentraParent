network row10a broker delivery semantics

semantic=local-idempotency-queue-proof
brokerDeliveryImplemented=false
relayHubDeliveryImplemented=false
duplicateDetection=queued-and-completed-idempotency-rejection
replay=broker-replay-plan-ref-preserved
droppedEventAudit=queue-overflow-dead-letter-count-preserved
adapterAction=zero-enforcement-command-events-and-zero-adapter-action-executed

network-broker-delivery-tests: cargo test -p ocentra-parent-agent-core network_runtime_broker_delivery -> exit 0; log=output\network-plan-proof\10a-broker-delivery-proof\broker-delivery-tests.log
network-queue-idempotency-tests: cargo test -p ocentra-parent-agent-core network_runtime_queue_idempotency_rejects_queued_and_completed_duplicates -> exit 0; log=output\network-plan-proof\10a-broker-delivery-proof\queue-idempotency-tests.log
network-queue-overflow-tests: cargo test -p ocentra-parent-agent-core network_runtime_queue_overflow_dead_letters_oldest_flow -> exit 0; log=output\network-plan-proof\10a-broker-delivery-proof\queue-overflow-tests.log
eventing-delivery-decision-tests: cargo test -p ocentra-eventing delivery_decision -> exit 0; log=output\network-plan-proof\10a-broker-delivery-proof\eventing-delivery-decision-tests.log
agent-core-clippy: cargo clippy -p ocentra-parent-agent-core --all-targets -- -D warnings -> exit 0; log=output\network-plan-proof\10a-broker-delivery-proof\agent-core-clippy.log
source-shape: node scripts/check-source-shape.mjs -> exit 0; log=output\network-plan-proof\10a-broker-delivery-proof\source-shape.log
