{
  "name": "@ocentra-parent/workspace",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev/dev-stack.mjs",
    "dev:lan": "node scripts/dev/dev-stack.mjs --lan",
    "dev:desktop": "node scripts/dev/dev-parent-desktop.mjs",
    "dev:desktop:lan": "node scripts/dev/dev-parent-desktop.mjs --lan",
    "dev:agent": "node scripts/dev/dev-agent.mjs",
    "dev:agent:lan": "node scripts/dev/dev-agent.mjs --lan",
    "dev:portal": "npm run build:contracts && node scripts/dev/dev-portal.mjs",
    "dev:portal:lan": "npm run build:contracts && node scripts/dev/dev-portal.mjs --lan",
    "lanes:init": "node scripts/dev/worktree-lanes.mjs init",
    "lanes:status": "node scripts/dev/worktree-lanes.mjs status",
    "lanes:claim": "node scripts/dev/worktree-lanes.mjs claim",
    "lanes:free": "node scripts/dev/worktree-lanes.mjs free",
    "lanes:guard": "node scripts/dev/worktree-lanes.mjs guard",
    "hub:status": "node scripts/dev/hub-mailbox.mjs status",
    "hub:inbox": "node scripts/dev/hub-mailbox.mjs inbox",
    "hub:watch": "node scripts/dev/hub-mailbox.mjs watch",
    "hub:hook": "node scripts/dev/codex-hub-hook.mjs",
    "hub:message": "node scripts/dev/hub-mailbox.mjs message",
    "hub:ack": "node scripts/dev/hub-mailbox.mjs ack",
    "hub:heartbeat": "node scripts/dev/hub-mailbox.mjs heartbeat",
    "hub:heartbeats": "node scripts/dev/hub-mailbox.mjs heartbeats",
    "hub:lane-ledger:audit": "powershell -ExecutionPolicy Bypass -File scripts/hub/audit-lanes.ps1",
    "hub:state:sync": "powershell -ExecutionPolicy Bypass -File scripts/hub/sync-codex-state.ps1",
    "hub:report": "node scripts/dev/hub-mailbox.mjs report",
    "hub:lock": "node scripts/dev/hub-mailbox.mjs lock",
    "hub:unlock": "node scripts/dev/hub-mailbox.mjs unlock",
    "hub:guard": "node scripts/dev/hub-mailbox.mjs guard",
    "build:contracts": "npm run build --workspace @ocentra-parent/schema-domain && npm run build --workspace @ocentra-parent/logging-domain && npm run build --workspace @ocentra-parent/parent-domain && npm run build --workspace @ocentra-parent/activity-domain && npm run build --workspace @ocentra-parent/agent-protocol-domain && npm run build --workspace @ocentra-parent/text-domain && npm run build --workspace @ocentra-parent/portal-domain",
    "prepare": "node scripts/git-hooks/install-pre-commit.mjs",
    "hooks:install": "node scripts/git-hooks/install-pre-commit.mjs",
    "precommit": "node scripts/git-hooks/run-precommit-validation.mjs",
    "precommit:full": "node scripts/git-hooks/run-precommit-validation.mjs --full",
    "ci:local": "npm run security:scan-repo && npm run format:check && npm run validate && npm run build",
    "playwright:install": "playwright install chromium",
    "release:version": "node scripts/release/validate-version.mjs",
    "release:package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/windows/build-agent-package.ps1",
    "release:package:linux": "bash scripts/release/linux/build-agent-package.sh",
    "release:package:macos": "bash scripts/release/macos/build-agent-package.sh",
    "release:package:android": "node scripts/release/android/build-agent-package.mjs",
    "release:package:ios": "bash scripts/release/ios/build-simulator-app.sh",
    "security:scan-staged": "node scripts/security/scan-staged-secrets.mjs",
    "security:scan-repo": "node scripts/security/scan-staged-secrets.mjs --repo",
    "security:deps": "node scripts/security/check-dependency-policy.mjs",
    "security:sbom": "node scripts/security/write-sbom.mjs",
    "build": "turbo run build",
    "test:tooling": "node scripts/test/parent-mobile-shell-runtime-proof.mjs && node --test scripts/test/*.test.mjs",
    "test:parent-mobile-shell-runtime-proof": "npm run build --workspace @ocentra-parent/parent-domain && node scripts/test/parent-mobile-shell-runtime-proof.mjs",
    "test:parent-desktop-release-support-proof": "node scripts/test/parent-desktop-release-support-proof.mjs",
    "test:mobile-child-agent-capability-proof": "node scripts/test/mobile-child-agent-capability-proof.mjs",
    "test:parent-mobile-service-bridge": "node scripts/test/parent-mobile-service-bridge-proof.mjs",
    "test:parent-mobile-controller-observer-handoff": "node scripts/test/parent-mobile-controller-observer-handoff-proof.mjs",
    "test:tracking-plan-pre-device-proof": "node scripts/test/tracking-plan-pre-device-proof.mjs",
    "test:tracking-plan-local-place-store-proof": "node scripts/test/tracking-plan-local-place-store-proof.mjs",
    "test:tracking-plan-android-emulator-proof": "node scripts/test/tracking-plan-android-emulator-proof.mjs",
    "test:tracking-plan-wsl-local-proof": "node scripts/test/tracking-plan-wsl-local-proof.mjs",
    "test:tracking-plan-ios-simulator-proof": "node scripts/test/tracking-plan-ios-simulator-proof.mjs",
    "test:tracking-plan-hosted-ui-proof": "node scripts/test/tracking-plan-hosted-ui-proof.mjs",
    "test:tracking-plan-evidence-quality-gate-proof": "node scripts/test/tracking-plan-evidence-quality-gate-proof.mjs",
    "test:tracking-plan-service-data-ui-proof": "node scripts/test/tracking-plan-service-data-ui-proof.mjs",
    "test:child-android-protocol-package-lifecycle-proof": "node scripts/test/child-android-protocol-package-lifecycle-proof.mjs",
    "test:child-android-permission-capability-proof": "node scripts/test/child-android-permission-capability-proof.mjs",
    "test:child-android-privileged-capability-proof": "node scripts/test/child-android-privileged-capability-proof.mjs",
    "test:child-android-device-proof-artifact-gate": "node scripts/test/child-android-device-proof-artifact-gate.mjs",
    "test:child-ios-entitlement-capability-proof": "node scripts/test/child-ios-entitlement-capability-proof.mjs",
    "test:child-android-storage-protocol-capability-proof": "node scripts/test/child-android-storage-protocol-capability-proof.mjs",
    "test:child-android-service-protocol-capability-proof": "node scripts/test/child-android-service-protocol-capability-proof.mjs",
    "test:unit": "turbo run test",
    "test:contract": "turbo run test --filter=@ocentra-parent/logging-domain --filter=@ocentra-parent/agent-protocol-domain --filter=@ocentra-parent/portal-domain --filter=@ocentra-parent/text-domain",
    "test:local": "npm run test && cargo test --workspace",
    "test:integration": "npm run build:contracts && cargo build -p ocentra-parent-agent-service && node scripts/test/websocket-local-smoke.mjs && node scripts/test/websocket-lan-smoke.mjs",
    "test:e2e": "npm run build:contracts && cargo build -p ocentra-parent-agent-service && node scripts/test/portal-local-smoke.mjs && npm run test:e2e --workspace @ocentra-parent/portal",
    "test:managed-browser-matrix": "node scripts/test/managed-browser-profile-matrix.mjs",
    "test:managed-browser-service-proof": "node scripts/test/managed-browser-service-proof.mjs",
    "test:child-agent-browser-intervention-page": "npm run build:contracts && node scripts/test/child-agent-browser-intervention-page-proof.mjs",
    "test:managed-browser-intervention": "npm run build:contracts && node scripts/test/managed-browser-intervention-proof.mjs",
    "test:managed-browser-composited-block": "npm run build:contracts && node scripts/test/managed-browser-composited-block-proof.mjs",
    "test:parent-mobile-shell-runtime": "node scripts/test/parent-mobile-shell-runtime-proof.mjs",
    "test:v0-9-mobile-controller-observer-runtime": "node scripts/test/v0-9-mobile-controller-observer-runtime-proof.mjs",
    "test:pre-ai-proof": "node scripts/check-pre-ai-proof.mjs",
    "lint:schema-boundaries": "node scripts/check-no-zod-source.mjs && node scripts/check-no-naked-domain-strings.mjs && node scripts/check-no-app-string-literals.mjs && node scripts/check-vendor-portal-asset-imports.mjs && node scripts/check-rust-string-boundaries.mjs && node scripts/check-required-tests.mjs && node scripts/check-single-source-contracts.mjs && node scripts/check-no-test-doubles.mjs && node scripts/check-source-shape.mjs && node scripts/check-ai-rule-index.mjs",
    "lint": "npm run lint:schema-boundaries && turbo run lint:exec type-check",
    "type-check": "turbo run type-check",
    "test": "npm run test:tooling && npm run test:unit && npm run test:contract",
    "format:rust": "cargo fmt --all --check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "validate:rust": "npm run format:rust && npm run lint:rust && cargo check --workspace && cargo test --workspace -- --test-threads=1",
    "validate": "npm run release:version && npm run test:pre-ai-proof && npm run lint && npm run test && npm run validate:rust && npm run test:integration && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.6.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.0"
  }
}
