<service>
  <id>OcentraChildUpdater</id>
  <name>Ocentra Child Updater</name>
  <description>Signed background updater for the Ocentra Child Agent.</description>
  <workingdirectory>%BASE%</workingdirectory>
  <executable>%BASE%\ocentra-child-agent-updater.exe</executable>
  <arguments>run-loop</arguments>
  <env
    name="OCENTRA_CHILD_UPDATE_MANIFEST_URL"
    value="https://github.com/ocentra/OcentraParent/releases/latest/download/latest-windows.json"
  />
  <env name="OCENTRA_CHILD_UPDATE_INITIAL_DELAY_SECONDS" value="120" />
  <env name="OCENTRA_CHILD_UPDATE_INTERVAL_SECONDS" value="3600" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="restart" delay="5 min" />
  <resetfailure>1 hour</resetfailure>
  <log mode="roll"></log>
</service>
