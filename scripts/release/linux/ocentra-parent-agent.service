[Unit]
Description=Ocentra Child Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/ocentra/ocentra-child-agent/bin/ocentra-child-agent-service
Restart=always
RestartSec=10
User=root
WorkingDirectory=/var/lib/ocentra/ocentra-child-agent
Environment=OCENTRA_CHILD_AGENT_DATA_DIR=/var/lib/ocentra/ocentra-child-agent

[Install]
WantedBy=multi-user.target
