{
  "name": "@ocentra-parent/local-api",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Typed local agent-service API route and command contract manifest.",
  "exports": {
    "./local-api": {
      "import": "./dist/local-api.js",
      "types": "./dist/local-api.d.ts"
    },
    "./package-info": {
      "import": "./dist/package-info.js",
      "types": "./dist/package-info.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/fix-esm-imports.mjs dist",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/local-api",
    "lint:exec": "eslint --cache src tests && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ocentra-parent/agent-protocol-domain": "file:../../packages/agent-protocol-domain",
    "@ocentra-parent/schema-domain": "file:../../packages/schema-domain"
  }
}
