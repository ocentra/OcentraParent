{
  "name": "@ocentra-parent/portal",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4478 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/portal",
    "lint:exec": "eslint --cache src tests e2e playwright.config.ts && tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests",
    "test:e2e": "node ../../scripts/test/portal-playwright-runner.mjs"
  },
  "dependencies": {
    "@ocentra-parent/activity-domain": "file:../../packages/activity-domain",
    "@ocentra-parent/agent-protocol-domain": "file:../../packages/agent-protocol-domain",
    "@ocentra-parent/app-game-domain": "file:../../packages/app-game-domain",
    "@ocentra-parent/browser-domain": "file:../../packages/browser-domain",
    "@ocentra-parent/evidence-domain": "file:../../packages/evidence-domain",
    "@ocentra-parent/logging-domain": "file:../../packages/logging-domain",
    "@ocentra-parent/network-domain": "file:../../packages/network-domain",
    "@ocentra-parent/parent-domain": "file:../../packages/parent-domain",
    "@ocentra-parent/portal-domain": "file:../../packages/portal-domain",
    "@ocentra-parent/schema-domain": "file:../../packages/schema-domain",
    "@ocentra-parent/screen-domain": "file:../../packages/screen-domain",
    "@ocentra-parent/social-domain": "file:../../packages/social-domain",
    "@tauri-apps/api": "^2.11.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  }
}
