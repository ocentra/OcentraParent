{
  "name": "@ocentra-parent/portal",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4478 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && node ../../node_modules/vite/bin/vite.js build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "npx turbo run lint:exec --filter=@ocentra-parent/portal",
    "lint:exec": "eslint --cache src tests playwright.config.ts && tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests --exclude \"tests/e2e/**\"",
    "test:e2e": "node ../../scripts/test/portal-playwright-runner.mjs"
  },
  "dependencies": {
    "@ocentra-parent/logging-domain": "file:../../packages/logging-domain",
    "@ocentra-parent/portal-domain": "file:../../packages/portal-domain",
    "@ocentra-parent/schema-domain": "file:../../packages/schema-domain",
    "@tauri-apps/api": "^2.11.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  }
}
