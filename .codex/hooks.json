{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "npm run --silent hub:hook",
            "timeout": 10,
            "statusMessage": "Loading Ocentra hub context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run --silent hub:hook",
            "timeout": 10,
            "statusMessage": "Refreshing Ocentra hub context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run --silent hub:hook",
            "timeout": 10,
            "statusMessage": "Checking Ocentra hub lane state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run --silent hub:hook",
            "timeout": 10,
            "statusMessage": "Checking Ocentra hub handoff"
          }
        ]
      }
    ]
  }
}
